# ---- Port exposed on the host ----
# 127.0.0.1 means only a reverse proxy on this machine can reach the container.
# An uncommon port, so the stack can share a server with others; change it if it is taken.
BIND_ADDRESS=127.0.0.1
WEB_PORT=6071

# Shared docker network with the backend stack. Create it once:
#   docker network create fr-task-shared
SHARED_NETWORK=fr-task-shared

# ---- Where the Spring Boot API lives ----
# Server-side only - the browser never sees this address. The Next.js server proxies
# every /api/* call to it, so there is no CORS to configure.
# Default resolves the API container by name over the shared docker network. For `npm run dev`
# use http://localhost:6070 (API in Docker) or http://localhost:8080 (API from `mvn spring-boot:run`).
# On a different server than the API, point it at https://api-task.firdovsirzaev.online.
BACKEND_URL=http://fr-task-api:8080

# ---- Optional: talk to the API straight from the browser instead of proxying ----
# Leave EMPTY to use the built-in proxy (recommended: one origin, no CORS).
# If you set it (e.g. https://api-task.firdovsirzaev.online), it is baked in at BUILD time
# (`docker compose up -d --build`) and the API's CORS_ALLOWED_ORIGINS must include
# https://task.firdovsirzaev.online.
NEXT_PUBLIC_API_URL=
